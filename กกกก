local function slider(text, min, max, step, default, cb)
    local holder = new("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = C.item, LayoutOrder = nextOrder() }, body)
    new("UICorner", { CornerRadius = UDim.new(0, 7) }, holder)
    local lbl = new("TextLabel", {
        Size = UDim2.new(1, -16, 0, 18), Position = UDim2.fromOffset(10, 3), BackgroundTransparency = 1,
        TextColor3 = C.text, Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
    }, holder)
    local track = new("Frame", { Size = UDim2.new(1, -20, 0, 6), Position = UDim2.fromOffset(10, 28), BackgroundColor3 = C.bar }, holder)
    new("UICorner", { CornerRadius = UDim.new(1, 0) }, track)
    local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = C.accent }, track)
    new("UICorner", { CornerRadius = UDim.new(1, 0) }, fill)

    local function setValue(v, fire)
        v = math.clamp(math.floor(v / step + 0.5) * step, min, max)
        fill.Size = UDim2.new((v - min) / (max - min), 0, 1, 0)
        lbl.Text = string.format("%s: %s", text, tostring(math.floor(v * 100 + 0.5) / 100))
        if fire then pcall(cb, v) end
    end
    setValue(default, false)

    local dragging = false
    local function fromX(x)
        local a = (x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1)
        setValue(min + math.clamp(a, 0, 1) * (max - min), true)
    end
    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true; fromX(i.Position.X)
        end
    end)
    table.insert(Hub.Conns, UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then fromX(i.Position.X) end
    end))
    table.insert(Hub.Conns, UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end))
end

------------------------------------------------------------------ Logic
function Hub.Stop()
    Hub.Running = false
    for _, c in ipairs(Hub.Conns) do pcall(function() c:Disconnect() end) end
    pcall(function() gui:Destroy() end)
end

local function addWords(text)
    local n = 0
    for line in string.gmatch(text, "[^\r\n]+") do
        local w = line:gsub("^%s+", ""):gsub("%s+$", "")
        if w ~= "" and not Hub.Dict[w] then
            Hub.Dict[w] = true
            Hub.List[#Hub.List + 1] = w
            n = n + 1
        end
    end
    Hub.Cache = {}
    return n
end

local function loadDictFile()
    local ok, data = pcall(function()
        if readfile and isfile and isfile(DICT_FILE) then return readfile(DICT_FILE) end
    end)
    if ok and data then return addWords(data) end
    return 0
end

local function downloadDict()
    local data, err
    local ok, r = pcall(function() return game:HttpGet(DICT_URL) end)
    if ok and type(r) == "string" then data = r else err = tostring(r) end
    if not data then
        local req = (syn and syn.request) or (http and http.request) or http_request or request
        if req then
            local ok2, res = pcall(function() return req({ Url = DICT_URL, Method = "GET" }) end)
            if ok2 and res and res.Body then data = res.Body else err = tostring(res) end
        end
    end
    if not data or #data < 1000 then return false, err or "ไม่ได้ข้อมูล" end
    pcall(function() if writefile then writefile(DICT_FILE, data) end end)
    addWords(data)
    return true
end

local function getLetters()
    local ok, res = pcall(function()
        local tiles = LP.PlayerGui.WordLinkUI.Canvas.Top.Round.Letters.Tiles
        local list = {}
        for _, d in ipairs(tiles:GetDescendants()) do
            if d:IsA("TextLabel") and d.Text ~= "" and d.Visible then
                table.insert(list, { x = d.AbsolutePosition.X, t = d.Text })
            end
        end
        table.sort(list, function(a, b) return a.x < b.x end)
        local s = {}
        for _, v in ipairs(list) do table.insert(s, v.t) end
        return table.concat(s)
    end)
    if ok and res and res ~= "" then return res end
    return nil
end

local function getRemote()
    local r = RS:FindFirstChild("Remotes")
    return r and r:FindFirstChild("MatchInput")
end

local sentTimes = {}
local function canSend()
    local now = os.clock()
    local keep = {}
    for _, t in ipairs(sentTimes) do if now - t < 10 then keep[#keep + 1] = t end end
    sentTimes = keep
    return #sentTimes < Hub.Flags.MaxPer10
end

local function candidates(letters)
    local key = letters .. (Hub.Flags.Prefix and "|p" or "|c")
    local c = Hub.Cache[key]
    if c then return c end
    c = {}
    for _, w in ipairs(Hub.List) do
        local hit
        if Hub.Flags.Prefix then hit = (string.sub(w, 1, #letters) == letters)
        else hit = (string.find(w, letters, 1, true) ~= nil) end
        if hit and w ~= letters then c[#c + 1] = w end
    end
    Hub.Cache[key] = c
    return c
end

