------------------------------------------------------------------ Main loop
task.spawn(function()
    local lastLetters, roundSent, lastSend = nil, 0, 0
    while Hub.Running do
        pcall(function()
            local letters = getLetters()
            if letters ~= lastLetters then
                lastLetters, roundSent, lastSend = letters, 0, 0
            end

            if not Hub.Flags.Auto then
                st:Set("สถานะ: ปิดอยู่")
            elseif not letters then
                st:Set("สถานะ: รอเข้าแมตช์ (ยังไม่มีตัวอักษร)")
            elseif #Hub.List == 0 then
                st:Set("สถานะ: ยังไม่ได้โหลดพจนานุกรม")
            elseif not canSend() then
                st:Set("สถานะ: พักตามลิมิต")
            elseif roundSent > 0 and os.clock() - lastSend < Hub.Flags.Retry then
                st:Set("สถานะ: รอผล '" .. letters .. "'")
            elseif roundSent >= Hub.Flags.MaxTries then
                st:Set("สถานะ: ลองครบตามกำหนดแล้ว รอรอบใหม่")
            else
                local list = candidates(letters)
                local pick
                for _ = 1, 30 do
                    if #list == 0 then break end
                    local w = list[math.random(1, #list)]
                    if not Hub.Used[w] then pick = w break end
                end
                if not pick then
                    for _, w in ipairs(list) do if not Hub.Used[w] then pick = w break end end
                end

                if not pick then
                    st:Set("สถานะ: ไม่มีคำที่ใช้ได้สำหรับ '" .. letters .. "'")
                else
                    task.wait(Hub.Flags.DelayMin + math.random() * (Hub.Flags.DelayMax - Hub.Flags.DelayMin))
                    -- เช็กอีกรอบหลังดีเลย์ ว่ายังเป็นรอบเดิมและยังเปิดอยู่
                    if Hub.Running and Hub.Flags.Auto and getLetters() == letters then
                        local remote = getRemote()
                        if remote then
                            Hub.Used[pick] = true
                            remote:FireServer(pick)
                            sentTimes[#sentTimes + 1] = os.clock()
                            roundSent = roundSent + 1
                            lastSend = os.clock()
                            Hub.Count = Hub.Count + 1
                            cntLbl:Set("ส่งไปแล้ว: " .. Hub.Count .. " (ล่าสุด: " .. pick .. ")")
                            st:Set("สถานะ: ส่ง '" .. pick .. "' (" .. letters .. ")")
                        else
                            st:Set("สถานะ: ไม่พบ Remotes.MatchInput")
                        end
                    end
                end
            end
        end)
        task.wait(0.4)
    end
end)

